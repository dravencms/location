{
  "name": "dravencms/location",
  "type": "dravencms-package",
  "description": "DravenCMS Location module",
  "keywords": [
    "dravencms",
    "location"
  ],
  "license": [
    "LGPL-3.0"
  ],
  "authors": [
    {
      "name": "Adam Schubert"
    }
  ],
  "require": {
    "umpirsky/country-list": "^2.0",
    "dravencms/application": ">=0.0.2",
    "dravencms/database": ">=0.0.3",
    "dravencms/base-form": ">=0.0.1",
    "dravencms/base-grid": ">=0.0.1",
    "php": ">=8.2",
    "symfony/console": "^6.4 || ^7.0 || ^8.0",
    "composer-runtime-api": "^2.0"
  },
  "suggest": {
    "dravencms/admin": "Provides admin inteface to manage locations",
    "dravencms/user": "Provides ACL settings"
  },
  "autoload": {
    "psr-0": {
      "Dravencms\\": "src/"
    }
  },
  "extra": {
    "dravencms": {
      "configuration": "dravencms.config.neon"
    }
  },
  "conflict": {
    "dravencms/admin": "<3.0",
    "dravencms/user": "<3.0"
  }
}
