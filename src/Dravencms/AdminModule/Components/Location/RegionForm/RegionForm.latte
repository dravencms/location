<form n:name="form" class="card">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-12">
                <div class="mb-3">
                    <label class="form-label" n:name="name">{_'location.admin.field.name'}</label>
                    <input type="text" n:name="name" autofocus="autofocus" class="form-control">
                </div>
            </div><!-- col-sm-12 -->
        </div><!-- row -->
        <div class="row">
            <div class="col-sm-12">
                <div class="mb-3">
                    <label class="form-label" n:name="cities">{_'location.admin.field.cities'}</label>
                    <select n:name="cities" class="form-control" data-placeholder="{_'location.admin.action.selectCities'}"></select>
                </div>
            </div><!-- col-sm-6 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isActive" class="form-check-input"> <span class="form-check-label">{_'location.admin.field.active'}</span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <input type="submit" n:name="send" class="btn btn-success button" value="{_'location.admin.action.save'}">
    </div>
</form>


